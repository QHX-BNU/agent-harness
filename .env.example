# 复制成 .env 只是给人看的参考；本项目的配置全部读环境变量，
# 真正生效的是你在 shell 里 set 的值（或 Docker/CI 的环境变量）。
# 用法: node scripts/probe.js 先自检，再 node server.js

# ---- 选一家 ----
PROVIDER=deepseek
# 通用 key（任何厂商都能用），或改用各家专属变量（见 README 表格）
API_KEY=
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DASHSCOPE_API_KEY=
MOONSHOT_API_KEY=
ZHIPU_API_KEY=
OPENROUTER_API_KEY=
SILICONFLOW_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=

# ---- 覆盖（一般不用填，填了优先于厂商预设）----
# MODEL=deepseek-reasoner
# BASE_URL=https://api.deepseek.com/v1
# MODEL_TIMEOUT_MS=120000
# MODEL_RETRIES=2

# ---- 服务 ----
PORT=5175
HOST=127.0.0.1
WORKSPACE=D:\Agent\DSH\harness

# ---- 策略 ----
# auto 全放行 / ask 写与执行需确认 / deny 禁止
APPROVAL_MODE=ask
APPROVAL_TIMEOUT_MS=120000

# ---- 预算 ----
MAX_STEPS=12
MAX_HISTORY_CHARS=60000
TOOL_RESULT_MAX_CHARS=8000
SHELL_TIMEOUT_MS=60000

# ---- 记忆 ----
MEMORY_ENABLED=1
MEMORY_TOP_K=5
MEMORY_DIR=.memory

# ---- 子代理 / 工作流 ----
MAX_AGENT_DEPTH=2
MAX_CONCURRENT_AGENTS=3
WORKFLOWS_DIR=workflows

# ---- 沙箱（作用区域 / 权限 / 后端）----
# scope:   workspace（仅工作区，默认） | home（用户主目录） | custom（自定义根目录） | full（整个文件系统）
# mode:    write（可写） | readonly（只读：禁写文件、禁写类命令）
# backend: local（本地策略沙箱） | docker | wsl（需本机装好，否则自动回落 local）
SANDBOX_SCOPE=workspace
SANDBOX_MODE=write
SANDBOX_BACKEND=local
# custom 作用区域时的根目录，分号或换行分隔
SANDBOX_ROOTS=
# 0 = 关闭命令路径扫描（危险命令仍然硬拦）
SANDBOX_STRICT=1
SANDBOX_IMAGE=alpine:3
# 1 = 允许容器访问网络（默认禁网）
SANDBOX_NETWORK=0

# ---- 存储 ----
SESSIONS_DIR=.sessions
ARTIFACTS_DIR=.artifacts

# ---- 飞书通道：群里 @ 机器人干活 ----
# 打开后 harness 会用 lark-cli 的 WebSocket 长连接收 im.message.receive_v1，不需要公网回调地址
FEISHU_ENABLED=1
# 机器人名字（识别有没有被 @；第一次按名字匹配成功后会自动记住它的 open_id）
FEISHU_BOT_NAME=你的机器人名字
# 别名，逗号分隔（改过名/群里显示名不同时用）
FEISHU_BOT_ALIASES=
# 也可以直接写死 open_id，省掉名字匹配这一步
FEISHU_BOT_OPEN_ID=
# 0 = 群里不 @ 也响应（默认 1：只响应 @ 机器人的消息；私聊始终响应）
FEISHU_REQUIRE_MENTION=1
# 结论回复到话题里（默认 1）
FEISHU_REPLY_IN_THREAD=1
# 飞书来的会话落在哪个工作区
FEISHU_WORKSPACE_ID=default
# 按群指定工作区：oc_xxx=wid1,oc_yyy=wid2
FEISHU_WORKSPACE_MAP=
# 机器人没人可问，默认自动放行写/执行类工具；策略层与沙箱仍然生效
FEISHU_APPROVAL_MODE=auto
# 私聊隔离（默认开）：私聊会话不会被任何群/别人查到，私聊里写的事实也会降级为会话级
FEISHU_PRIVATE_ISOLATION=1
# 0 = 机器人完全不理会私聊，只服务群
FEISHU_ALLOW_P2P=1
# 跨群查询开关（默认开）：0 = 关掉 user_activity / session_list / session_read
FEISHU_CROSS_GROUP=1
# 任务超过多久先回一句「还在处理」
FEISHU_PROGRESS_AFTER_MS=15000
# 单条回复字符上限（超出自动分片）
FEISHU_CHUNK_SIZE=3000
# 事件订阅断开后的重连次数
FEISHU_MAX_RESTARTS=5
