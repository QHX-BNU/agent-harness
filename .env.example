# 复制成 .env 只是给人看的参考；本项目的配置全部读环境变量，
# 真正生效的是你在 shell 里 set 的值（或 Docker/CI 的环境变量）。
# 用法: node scripts/probe.js 先自检，再 node server.js

# ---- 选一家 ----
PROVIDER=deepseek
# 通用 key（任何厂商都能用），或改用各家专属变量（见 README 表格）
API_KEY=
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DASHSCOPE_API_KEY=
MOONSHOT_API_KEY=
ZHIPU_API_KEY=
OPENROUTER_API_KEY=
SILICONFLOW_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=

# ---- 覆盖（一般不用填，填了优先于厂商预设）----
# MODEL=deepseek-reasoner
# BASE_URL=https://api.deepseek.com/v1
# MODEL_TIMEOUT_MS=120000
# MODEL_RETRIES=2

# ---- 服务 ----
PORT=5175
HOST=127.0.0.1
WORKSPACE=D:\Agent\DSH\harness

# ---- 策略 ----
# auto 全放行 / ask 写与执行需确认 / deny 禁止
APPROVAL_MODE=ask
APPROVAL_TIMEOUT_MS=120000

# ---- 预算 ----
MAX_STEPS=12
MAX_HISTORY_CHARS=60000
TOOL_RESULT_MAX_CHARS=8000
SHELL_TIMEOUT_MS=60000

# ---- 记忆 ----
MEMORY_ENABLED=1
MEMORY_TOP_K=5
MEMORY_DIR=.memory

# ---- 子代理 / 工作流 ----
MAX_AGENT_DEPTH=2
MAX_CONCURRENT_AGENTS=3
WORKFLOWS_DIR=workflows

# ---- 沙箱（作用区域 / 权限 / 后端）----
# scope:   workspace（仅工作区，默认） | home（用户主目录） | custom（自定义根目录） | full（整个文件系统）
# mode:    write（可写） | readonly（只读：禁写文件、禁写类命令）
# backend: local（本地策略沙箱） | docker | wsl（需本机装好，否则自动回落 local）
SANDBOX_SCOPE=workspace
SANDBOX_MODE=write
SANDBOX_BACKEND=local
# custom 作用区域时的根目录，分号或换行分隔
SANDBOX_ROOTS=
# 0 = 关闭命令路径扫描（危险命令仍然硬拦）
SANDBOX_STRICT=1
SANDBOX_IMAGE=alpine:3
# 1 = 允许容器访问网络（默认禁网）
SANDBOX_NETWORK=0

# ---- 存储 ----
SESSIONS_DIR=.sessions
ARTIFACTS_DIR=.artifacts
