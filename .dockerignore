# 不进镜像的东西：运行态数据、测试产物、截图、依赖目录
.git
.gitignore
.gitattributes
.github

# 运行态数据（容器里用 /data 卷，宿主机的这些不该进镜像）
.sessions/
.sessions-trash/
.sessions-test/
.artifacts/
.artifacts-test/
.channels/
.memory/
.sandbox-tmp/
.workspaces.json
.runtime-model.json
.lark-app-secret
.env
.env.local

# 测试与文档产物
e2e/
ui-check/
trace/
out/
demo/
docs/
node_modules/
*.log

# 容器自身的文件（运行时不需要）
Dockerfile
Dockerfile.node
docker-compose.yml
.dockerignore
docker-run.cmd
docker-run.sh
