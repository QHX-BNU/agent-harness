# 会话与状态
.sessions/
.sessions-test/
# 回收站：删掉的会话（属于运行态数据，不进仓库）
.sessions-trash/
.artifacts/
.artifacts-test/
.channels/
.memory/
.sandbox-tmp/
.workspaces.json

# 密钥：绝不入库
.lark-app-secret
.runtime-model.json
.env
.env.local

# 项目自带的运行时（Bun 二进制 ~80MB，不进 git；打包分发时再带上）
runtime/bin/
runtime/VERSION

# 测试产物
e2e/
ui-check/
demo/
out/
trace/

# docker-compose 的安全默认工作区（只保留占位文件）
workspace/*
!workspace/.gitkeep

node_modules/
*.log
# 技能（技能包 = 目录 + SKILL.md，属运行态数据；要备份就用 GET /api/skills/:name/export）
.skills/
